# ============================================================
# Knowledge service
# ============================================================
# Copy to knowledge/.env for local development. In production these are set
# on the Railway service; never commit real values.

# development | test | production
NODE_ENV=development
PORT=3100
# Interface to bind. The default, `::`, listens on IPv6 and IPv4 (dual-stack on
# Linux and Windows), so callers can use either address. Set 0.0.0.0 on a host
# with IPv6 disabled; with 0.0.0.0 (IPv4 only), point callers at
# http://127.0.0.1:3100, not localhost, which Windows resolves to ::1 first.
# HOST=::

# Same Supabase Postgres as the backend; this service only touches the
# `knowledge` and `knowledge_migrations` schemas. Needs pgvector 0.8+ in the
# `extensions` schema on the search_path (Supabase's default). Prepared
# statements are off, so a direct connection, the session pooler or the
# transaction pooler (port 6543) all work.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable

# Two secrets, both sent in the `x-knowledge-key` header (never in a URL),
# each at least 32 characters and different from each other:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The service key opens only the service routes (/retrieve, /version), for the
# portfolio and hunter backends.
KNOWLEDGE_SERVICE_KEY=
# The owner key opens only the owner routes (/documents, /search). Only the
# backend's owner proxy holds it: the backend checks the Supabase JWT and
# OWNER_AUTH_ID, then forwards the request with this key. Set the backend's
# KNOWLEDGE_OWNER_KEY to the same value.
KNOWLEDGE_OWNER_KEY=

# The Supabase auth user id (JWT `sub`) that owns the knowledge base. Letters,
# digits, ".", "_" and "-" only: it is the first segment of every storage key.
OWNER_AUTH_ID=

# ---- Embeddings ----
# openai (default) | openrouter | hashing (offline, word-overlap only; dev/tests,
# refused in production)
EMBEDDER=hashing
# Required when EMBEDDER=openai
# OPENAI_API_KEY=
# Required when EMBEDDER=openrouter
# OPENROUTER_API_KEY=
# Optional override. Defaults: text-embedding-3-small (openai),
# openai/text-embedding-3-small (openrouter). Must output 1536 dimensions to
# match the `chunks.embedding` column.
# EMBEDDING_MODEL=

# ---- Raw file storage ----
# supabase (default) | local (development only; Railway disks are ephemeral)
FILE_STORE=local
# LOCAL_FILE_STORE_DIR=.data/files

# Required when FILE_STORE=supabase. The bucket must exist and be private.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SECRET_KEY=
# STORAGE_BUCKET=portfolio-files

# Upload limit in bytes (default 10 MB, at most 50 MB)
# MAX_UPLOAD_BYTES=10485760

# Re-queue documents left pending/processing by a previous process (default true)
# RESUME_INGESTION_ON_BOOT=true
