# ============================================================
# Knowledge service
# ============================================================
# Copy to knowledge/.env for local development. In production these are set
# on the Railway service; never commit real values.

# development | test | production
NODE_ENV=development
PORT=3100

# Same Supabase Postgres as the backend; this service only touches the
# `knowledge` and `knowledge_migrations` schemas.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable

# Shared secret for callers (the portfolio and hunter backends). Sent in the
# `x-knowledge-key` header, never in a URL. At least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KNOWLEDGE_SERVICE_KEY=

# The Supabase auth user id (JWT `sub`) that owns the knowledge base.
OWNER_AUTH_ID=

# ---- Embeddings ----
# openrouter (default) | hashing (offline, word-overlap only; dev/tests, refused in production)
EMBEDDER=hashing
# Required when EMBEDDER=openrouter
# OPENROUTER_API_KEY=
# Must output 1536 dimensions to match the `chunks.embedding` column.
# EMBEDDING_MODEL=openai/text-embedding-3-small

# ---- Raw file storage ----
# supabase (default) | local (development only; Railway disks are ephemeral)
FILE_STORE=local
# LOCAL_FILE_STORE_DIR=.data/files

# Required when FILE_STORE=supabase. The bucket must exist and be private.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SECRET_KEY=
# STORAGE_BUCKET=portfolio-files

# Upload limit in bytes (default 10 MB)
# MAX_UPLOAD_BYTES=10485760

# Re-queue documents left pending/processing by a previous process (default true)
# RESUME_INGESTION_ON_BOOT=true
