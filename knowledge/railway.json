{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd knowledge && pnpm install && pnpm build"
  },
  "deploy": {
    "startCommand": "cd knowledge && pnpm start",
    "preDeployCommand": "cd knowledge && pnpm db:migrate:prod",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
