# Backend environment template
#
# Copy to backend/.env and fill in the values:
#   cp .env.example .env
#
# IMPORTANT
#   - Only ONE DATABASE_URL may be active. dotenv resolves duplicates by
#     "last occurrence wins", so a stale line silently overrides the intended one.
#   - JSON values MUST be on a single line. dotenv stops parsing a value at the
#     first newline, which turns a multi-line JSON blob into invalid JSON.
#   - This file is gitignored (`.env`, `.env.*`). Only `.env.example` is tracked.
#
# ENVIRONMENT FILES
#   .env          local development (this file's shape, points at local Supabase)
#   .env.remote   copy of .env pointing at the remote database
#   To use a different file, set DOTENV_CONFIG_PATH before running a command:
#     DOTENV_CONFIG_PATH=.env.remote pnpm run db:push

# ============================================================
# App
# ============================================================

# development | production
NODE_ENV=development

# Port the Fastify server listens on (default: 3000)
PORT=3000

# Interface to bind (default: 0.0.0.0)
# HOST=0.0.0.0

# ============================================================
# Database (required)
# ============================================================

# Local Supabase (requires `supabase start` from the repo root)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable

# Remote Supabase - copy from Dashboard -> Settings -> Database
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ============================================================
# Authentication (required for the /job-hunt/* routes)
# ============================================================

# Supabase project URL. Used to derive the JWKS endpoint and to link
# signed-in users to local `users` rows.
# Must match the frontend's VITE_SUPABASE_URL, because the API verifies the
# tokens that project issues.
#
# Local Supabase (run `supabase start` from the repo root):
# SUPABASE_URL=http://127.0.0.1:54321
#
# Hosted project:
# SUPABASE_URL=https://your-project-ref.supabase.co

# Optional: point at the JWKS endpoint explicitly. Defaults to
# $SUPABASE_URL/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Legacy shared-secret mode (HS256). Only needed for older projects that
# still use the JWT secret instead of rotating asymmetric keys.
# SUPABASE_JWT_SECRET=your_jwt_secret

# Development only: impersonate the seeded user so the job-hunter can be
# exercised without a Supabase project. Refused when NODE_ENV=production.
# AUTH_DEV_BYPASS=true

# ============================================================
# Job hunter
# ============================================================

# How long a refresh may run before it is considered abandoned and marked
# as failed on the next startup, in minutes (default: 30)
# JOB_REFRESH_STALE_MINUTES=30

# Log level for the standalone refresh runner (default: info)
# LOG_LEVEL=info

# ============================================================
# Knowledge service owner proxy (optional; /knowledge/* routes)
# ============================================================
# These serve the owner's Knowledge page only. Chat retrieval shares
# KNOWLEDGE_URL but uses a different credential, KNOWLEDGE_SERVICE_KEY (see
# Portfolio below): the owner key and the service key open different routes on
# the knowledge service.

# The Supabase auth user id (JWT `sub`) that owns the knowledge base. Only
# this user sees the Knowledge page; anyone else gets 403 on /knowledge/*.
# Use the same value as the knowledge service's OWNER_AUTH_ID. Unset means
# nobody is the owner. With AUTH_DEV_BYPASS=true the signed-in subject is
# `auth-dev-bypass`, so set OWNER_AUTH_ID=auth-dev-bypass to use the page
# without Supabase (and the same value on the knowledge service).
# OWNER_AUTH_ID=

# Where the knowledge service listens. On Railway it is private-network only:
# http://six7sweknowledge.railway.internal:3100
# Locally, use 127.0.0.1 rather than localhost: Windows resolves localhost to ::1
# first, which fails if the service listens on IPv4 only (HOST=0.0.0.0).
# KNOWLEDGE_URL=http://127.0.0.1:3100

# The knowledge service's KNOWLEDGE_OWNER_KEY (same value). The backend sends
# it, never the user's token, once it has checked the caller is the owner.
# Set KNOWLEDGE_URL and KNOWLEDGE_OWNER_KEY together (one alone fails the boot);
# with neither, the owner gets 503 on /knowledge/*.
# KNOWLEDGE_OWNER_KEY=

# ============================================================
# AI provider - MiniMax (required for /chat, /fitcheck)
# ============================================================

# Get your API key from https://minimax.io
MINIMAX_API_KEY=your_minimax_api_key_here

# Optional fallback used once when the primary key receives HTTP 429
# MINIMAX_API_KEY_SECONDARY=your_secondary_minimax_api_key_here

# ============================================================
# Email - Resend (required for /contact)
# ============================================================

# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Sender address for outbound mail. Must be on a domain verified in Resend.
# The Supabase Auth SMTP settings use the same address, so confirmation
# emails and the contact form come from one identity.
RESEND_FROM_EMAIL=no-reply@auth.your-domain.dev

# Display name shown next to the sender address (optional).
# RESEND_FROM_NAME=Ray Manguino

# ============================================================
# Portfolio
# ============================================================

# How long the portfolio payload stays cached in memory, in ms (default: 600000)
# PORTFOLIO_CACHE_TTL_MS=600000

# Where portfolio data comes from:
#   db        - PostgreSQL via Drizzle (default); chat gets the whole resume and every section
#   knowledge - PostgreSQL for the portfolio, but chat gets a compact profile summary plus the
#               chunks the knowledge service retrieves for each question. The server
#               refuses to start without KNOWLEDGE_URL and KNOWLEDGE_SERVICE_KEY;
#               if the service is down, chat answers from the profile summary alone.
#   mcp       - an MCP server exposing the portfolio tools
# PORTFOLIO_DATA_SOURCE=db

# ---- Knowledge mode only (PORTFOLIO_DATA_SOURCE=knowledge) ----
# Retrieval uses KNOWLEDGE_URL (set above, shared with the owner proxy; pnpm
# dev:knowledge listens on 3100) and the service's KNOWLEDGE_SERVICE_KEY.
# KNOWLEDGE_SERVICE_KEY=
# Chunks retrieved per question (default 6, at most 20; production sets 10 in .railway/railway.ts)
# KNOWLEDGE_RETRIEVE_K=6
# Per-request timeout in ms (default 3000)
# KNOWLEDGE_TIMEOUT_MS=3000

# ---- MCP mode only (PORTFOLIO_DATA_SOURCE=mcp) ----
# Provide a streamable HTTP URL or a stdio command (one is required).
# MCP_PORTFOLIO_URL=http://127.0.0.1:3333/mcp
# MCP_PORTFOLIO_COMMAND=npx
# MCP_PORTFOLIO_ARGS_JSON=["-y","@your-scope/portfolio-mcp"]

# Optional HTTP auth / headers (single line, valid JSON)
# MCP_PORTFOLIO_BEARER_TOKEN=
# MCP_PORTFOLIO_HEADERS_JSON={"X-Custom":"value"}

# Tool names must match the names exposed by your MCP server.
# MCP_PORTFOLIO_TOOL_GET=get_portfolio
# MCP_RESUME_TOOL_GET=get_resume_pdf

# Attach the MCP server to the chat / fitcheck agents (default: true)
# AGENT_MCP_ENABLED=true
