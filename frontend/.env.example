# Frontend environment template
#
# Copy to frontend/.env and fill in the values:
#   cp .env.example .env
#
# This file is gitignored. Only .env.example is tracked.

# ============================================================
# Backend API
# ============================================================

# Base URL of the backend API.
# THIS is the only optional variable: leave it unset to use the Vite dev
# proxy at /api (defaults to http://localhost:3000 in development).
# VITE_API_URL=http://localhost:3000

# ============================================================
# Authentication (required for the /hunter pages)
# ============================================================

# Both variables below are REQUIRED for the /hunter pages. Leaving them unset
# makes the app show "Authentication is not configured" and the job-hunter
# cannot be used. The public portfolio does not need them.
#
# VITE_SUPABASE_URL must match the backend's SUPABASE_URL, because the API
# verifies the tokens that project issues.
#
# Local Supabase: http://127.0.0.1:54321 (run `supabase start` from the repo
# root, then `supabase status` for the publishable key).

# Supabase project URL. The job-hunter signs users in with Supabase Auth.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key. Safe to ship to the browser.
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
