meta {
  name: Get portfolio
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/portfolio
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("returns portfolio data", function () {
    expect(res.body).to.be.an("object");
  });
}

docs {
  Public. Profile, skills, experience and projects for the landing page. Cached in memory (PORTFOLIO_CACHE_TTL_MS).
}
