meta {
  name: Get profile
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/knowledge/profile
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("returns both stages and the drafting status", function () {
    expect(res.body).to.have.property("draft");
    expect(res.body).to.have.property("published");
    expect(res.body.drafting).to.have.property("state");
  });
}

docs {
  Owner only: 401 when signed out, 403 for any other user. Locally set AUTH_DEV_BYPASS=true and OWNER_AUTH_ID=auth-dev-bypass (see api/README.md).
  Forwarded to the knowledge service with KNOWLEDGE_OWNER_KEY; 503 when that is not configured.
}
