meta {
  name: Delete document
  type: http
  seq: 17
}

delete {
  url: {{baseUrl}}/knowledge/documents/:id
  body: none
  auth: inherit
}

params:path {
  id: {{createdDocumentId}}
}

script:pre-request {
  if (bru.getEnvVar("allowSideEffects") !== "true") {
    bru.runner.skipRequest();
  }
  if (!bru.getVar("createdDocumentId")) {
    bru.runner.skipRequest();
  }
}

assert {
  res.status: eq 204
}

docs {
  Changes the owner's corpus (new version, stale job scores, an eval run), so it is skipped unless allowSideEffects is "true".
  Deletes the document uploaded above, but only when that upload actually created it. A deduplicated upload returned a document the owner already had, so it is left alone: this request is skipped instead of deleting pre-existing data.
  Owner only: 401 when signed out, 403 for any other user. Locally set AUTH_DEV_BYPASS=true and OWNER_AUTH_ID=auth-dev-bypass (see api/README.md).
  Forwarded to the knowledge service with KNOWLEDGE_OWNER_KEY; 503 when that is not configured.
}
