meta {
  name: Search
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/knowledge/search
  body: json
  auth: inherit
}

body:json {
  {
    "query": "What are the strongest TypeScript skills?",
    "k": 3
  }
}

assert {
  res.status: eq 200
}

tests {
  test("returns chunks", function () {
    expect(res.body.chunks).to.be.an("array");
  });
}

docs {
  The "ask as a visitor" playground: the same retrieval the chat uses, never recorded. k is 1..20.
  Owner only: 401 when signed out, 403 for any other user. Locally set AUTH_DEV_BYPASS=true and OWNER_AUTH_ID=auth-dev-bypass (see api/README.md).
  Forwarded to the knowledge service with KNOWLEDGE_OWNER_KEY; 503 when that is not configured.
}
