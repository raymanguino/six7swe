meta {
  name: Eval question: unpin
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/knowledge/eval/questions/:id
  body: json
  auth: inherit
}

params:path {
  id: {{evalQuestionId}}
}

body:json {
  {
    "action": "unpin"
  }
}

script:pre-request {
  if (bru.getEnvVar("allowSideEffects") !== "true") {
    bru.runner.skipRequest();
  }
  if (!bru.getVar("evalQuestionId")) {
    bru.runner.skipRequest();
  }
}

assert {
  res.status: eq 200
}

tests {
  test("unpins the question", function () {
    expect(res.body.question.pinned).to.equal(false);
  });
}

docs {
  Undoes the pin above.
  Owner only: 401 when signed out, 403 for any other user. Locally set AUTH_DEV_BYPASS=true and OWNER_AUTH_ID=auth-dev-bypass (see api/README.md).
  Forwarded to the knowledge service with KNOWLEDGE_OWNER_KEY; 503 when that is not configured.
}
