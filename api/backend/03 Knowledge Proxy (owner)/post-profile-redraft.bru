meta {
  name: Redraft profile
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/knowledge/profile/draft
  body: none
  auth: inherit
}

script:pre-request {
  if (bru.getEnvVar("allowSideEffects") !== "true") {
    bru.runner.skipRequest();
  }
}

tests {
  test("responds with one of 202, 409", function () {
    expect(res.status).to.be.oneOf([202, 409]);
  });

  test("reports the drafting status", function () {
    if (res.status === 202) {
      expect(res.body.drafting).to.have.property("enabled");
    }
  });
}

docs {
  Drafts again from the primary resume in the background. Uses a model, so it is skipped unless allowSideEffects is "true". 409 when PROFILE_DRAFTER is none (drafting is off).
  Owner only: 401 when signed out, 403 for any other user. Locally set AUTH_DEV_BYPASS=true and OWNER_AUTH_ID=auth-dev-bypass (see api/README.md).
  Forwarded to the knowledge service with KNOWLEDGE_OWNER_KEY; 503 when that is not configured.
}
