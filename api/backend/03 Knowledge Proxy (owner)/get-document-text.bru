meta {
  name: Get document text
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/knowledge/documents/:id/text
  body: none
  auth: inherit
}

params:path {
  id: {{documentId}}
}

script:pre-request {
  if (!bru.getVar("documentId")) {
    bru.runner.skipRequest();
  }
}

assert {
  res.status: eq 200
}

tests {
  test("returns the text field", function () {
    expect(res.body).to.have.property("text");
  });
}

docs {
  Extracted text; null until ingestion has finished.
  Owner only: 401 when signed out, 403 for any other user. Locally set AUTH_DEV_BYPASS=true and OWNER_AUTH_ID=auth-dev-bypass (see api/README.md).
  Forwarded to the knowledge service with KNOWLEDGE_OWNER_KEY; 503 when that is not configured.
}
