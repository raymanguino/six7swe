meta {
  name: Save profile draft
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/knowledge/profile/draft
  body: json
  auth: inherit
}

body:json {
  {
    "data": {
      "name": "Bruno Example",
      "title": "Software Engineer",
      "location": "Toronto, Canada",
      "summary": "A sample profile saved from the Bruno collection.",
      "skills": [
        "TypeScript",
        "Fastify",
        "PostgreSQL"
      ],
      "experience": [
        {
          "title": "Software Engineer",
          "company": "Example Inc",
          "period": "2021 - 2024",
          "description": "Built and ran internal platforms."
        }
      ],
      "projects": [
        {
          "name": "Sample project",
          "description": "A demo project.",
          "technologies": [
            "TypeScript"
          ]
        }
      ],
      "links": {
        "email": null,
        "phone": null,
        "linkedin": null,
        "github": null,
        "website": null
      }
    }
  }
}

script:pre-request {
  if (bru.getEnvVar("allowSideEffects") !== "true") {
    bru.runner.skipRequest();
  }
}

script:post-response {
  if (res.status >= 200 && res.status < 300) {
    const draftVersion = res?.body?.profile?.version;
    if (typeof draftVersion === "number") {
      bru.setVar("draftVersion", draftVersion);
    }
  }
}

assert {
  res.status: eq 200
}

tests {
  test("saves the draft", function () {
    expect(res.body.profile.stage).to.equal("draft");
  });
}

docs {
  Overwrites the owner's draft, so it is skipped unless allowSideEffects is "true". Replaces the draft with the given edits. Links must be http(s) URLs or null.
  Stores the draft's version in draftVersion for Publish.
  Owner only: 401 when signed out, 403 for any other user. Locally set AUTH_DEV_BYPASS=true and OWNER_AUTH_ID=auth-dev-bypass (see api/README.md).
  Forwarded to the knowledge service with KNOWLEDGE_OWNER_KEY; 503 when that is not configured.
}
