meta {
  name: Discard profile draft
  type: http
  seq: 10
}

delete {
  url: {{knowledgeBaseUrl}}/profile/draft
  body: none
  auth: none
}

headers {
  x-knowledge-key: {{ownerKey}}
}

script:pre-request {
  if (bru.getEnvVar("allowSideEffects") !== "true") {
    bru.runner.skipRequest();
  }
}

tests {
  test("responds with one of 204, 404", function () {
    expect(res.status).to.be.oneOf([204, 404]);
  });
}

docs {
  404 when there is no draft.
  Owner key: only the backend's owner proxy holds it. The service key gets a 401 here.
}
