meta {
  name: Get profile
  type: http
  seq: 7
}

get {
  url: {{knowledgeBaseUrl}}/profile
  body: none
  auth: none
}

headers {
  x-knowledge-key: {{ownerKey}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns both stages and the drafting status", function () {
    expect(res.body).to.have.property("draft");
    expect(res.body).to.have.property("published");
    expect(res.body.drafting).to.have.property("state");
  });
}

docs {
  Owner key: only the backend's owner proxy holds it. The service key gets a 401 here.
}
