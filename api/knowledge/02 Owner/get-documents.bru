meta {
  name: List documents
  type: http
  seq: 1
}

get {
  url: {{knowledgeBaseUrl}}/documents
  body: none
  auth: none
}

headers {
  x-knowledge-key: {{ownerKey}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns documents", function () {
    expect(res.body.documents).to.be.an("array");
  });
}

docs {
  Owner key: only the backend's owner proxy holds it. The service key gets a 401 here.
}
