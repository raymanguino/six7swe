meta {
  name: Save profile draft
  type: http
  seq: 8
}

put {
  url: {{knowledgeBaseUrl}}/profile/draft
  body: json
  auth: none
}

headers {
  x-knowledge-key: {{ownerKey}}
}

body:json {
  {
    "data": {
      "name": "Bruno Example",
      "title": "Software Engineer",
      "location": "Toronto, Canada",
      "summary": "A sample profile saved from the Bruno collection.",
      "skills": [
        "TypeScript",
        "Fastify",
        "PostgreSQL"
      ],
      "experience": [
        {
          "title": "Software Engineer",
          "company": "Example Inc",
          "period": "2021 - 2024",
          "description": "Built and ran internal platforms."
        }
      ],
      "projects": [
        {
          "name": "Sample project",
          "description": "A demo project.",
          "technologies": [
            "TypeScript"
          ]
        }
      ],
      "links": {
        "email": null,
        "phone": null,
        "linkedin": null,
        "github": null,
        "website": null
      }
    }
  }
}

script:pre-request {
  if (bru.getEnvVar("allowSideEffects") !== "true") {
    bru.runner.skipRequest();
  }
}

script:post-response {
  if (res.status >= 200 && res.status < 300) {
    const draftVersion = res?.body?.profile?.version;
    if (typeof draftVersion === "number") {
      bru.setVar("draftVersion", draftVersion);
    }
  }
}

assert {
  res.status: eq 200
}

tests {
  test("saves the draft", function () {
    expect(res.body.profile.stage).to.equal("draft");
  });
}

docs {
  Body limit 512 KB. Stores the draft's version in draftVersion for Publish.
  Optional "expectedVersion": the version of the draft the edits were made on (null: there was no draft). When the draft is no longer that one, nothing is saved and the answer is 409 with the current draft ({ error, draft }). Left out here, so the save is unconditional and the request can be run repeatedly.
  Owner key: only the backend's owner proxy holds it. The service key gets a 401 here.
}
