meta {
  name: Upload document
  type: http
  seq: 2
}

post {
  url: {{knowledgeBaseUrl}}/documents?kind=supporting
  body: multipartForm
  auth: none
}

headers {
  x-knowledge-key: {{ownerKey}}
}

params:query {
  kind: supporting
}

body:multipart-form {
  file: @file(fixtures/sample-notes.md)
}

script:pre-request {
  if (bru.getEnvVar("allowSideEffects") !== "true") {
    bru.runner.skipRequest();
  }
}

script:post-response {
  if (res.status >= 200 && res.status < 300) {
    const documentId = res?.body?.document?.id;
    if (documentId !== undefined && documentId !== null) {
      bru.setVar("documentId", documentId);
    }
  }
}

tests {
  test("responds with one of 200, 202", function () {
    expect(res.status).to.be.oneOf([200, 202]);
  });

  test("returns the document", function () {
    expect(res.body.document.id).to.match(/^[0-9a-f-]{36}$/);
  });
}

docs {
  Changes the owner's corpus (new version, stale job scores, an eval run), so it is skipped unless allowSideEffects is "true".
  One .pdf, .md or .txt file in a single "file" part. 202 when queued, 200 when deduplicated, 413 over MAX_UPLOAD_BYTES.
  Owner key: only the backend's owner proxy holds it. The service key gets a 401 here.
}
