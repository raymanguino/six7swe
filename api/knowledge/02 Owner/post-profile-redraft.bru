meta {
  name: Redraft profile
  type: http
  seq: 11
}

post {
  url: {{knowledgeBaseUrl}}/profile/draft
  body: none
  auth: none
}

headers {
  x-knowledge-key: {{ownerKey}}
}

script:pre-request {
  if (bru.getEnvVar("allowSideEffects") !== "true") {
    bru.runner.skipRequest();
  }
}

tests {
  test("responds with one of 202, 409", function () {
    expect(res.status).to.be.oneOf([202, 409]);
  });
}

docs {
  Drafts again from the primary resume in the background. Skipped unless allowSideEffects is "true". 409 when PROFILE_DRAFTER is none (drafting is off).
  Owner key: only the backend's owner proxy holds it. The service key gets a 401 here.
}
