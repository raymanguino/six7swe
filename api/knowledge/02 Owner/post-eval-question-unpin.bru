meta {
  name: Eval question: unpin
  type: http
  seq: 15
}

post {
  url: {{knowledgeBaseUrl}}/eval/questions/:id
  body: json
  auth: none
}

headers {
  x-knowledge-key: {{ownerKey}}
}

params:path {
  id: {{evalQuestionId}}
}

body:json {
  {
    "action": "unpin"
  }
}

script:pre-request {
  if (bru.getEnvVar("allowSideEffects") !== "true") {
    bru.runner.skipRequest();
  }
  if (!bru.getVar("evalQuestionId")) {
    bru.runner.skipRequest();
  }
}

assert {
  res.status: eq 200
}

tests {
  test("unpins the question", function () {
    expect(res.body.question.pinned).to.equal(false);
  });
}

docs {
  Undoes the pin above.
  Owner key: only the backend's owner proxy holds it. The service key gets a 401 here.
}
