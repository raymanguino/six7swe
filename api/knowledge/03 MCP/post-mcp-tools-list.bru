meta {
  name: MCP: list tools
  type: http
  seq: 1
}

post {
  url: {{knowledgeBaseUrl}}/mcp
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{mcpKey}}
  Content-Type: application/json
  Accept: application/json, text/event-stream
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/list",
    "params": {}
  }
}

assert {
  res.status: eq 200
}

tests {
  test("lists the four tools", function () {
    const names = res.body.result.tools.map((t) => t.name);
    expect(names).to.have.members(["search_background", "list_documents", "get_resume_pdf"]);
  });
}

docs {
  Stateless streamable HTTP: JSON-RPC 2.0 over POST, one server per request.
  MCP key as Authorization: Bearer. Any query string is a 401, so the key can never end up in a URL. With no KNOWLEDGE_MCP_KEY configured, /mcp is closed.
}
