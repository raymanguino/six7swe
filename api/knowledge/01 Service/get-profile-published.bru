meta {
  name: Published profile
  type: http
  seq: 4
}

get {
  url: {{knowledgeBaseUrl}}/profile/published
  body: none
  auth: none
}

headers {
  x-knowledge-key: {{serviceKey}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns profile and resume", function () {
    expect(res.body).to.have.property("profile");
    expect(res.body).to.have.property("resume");
  });
}

docs {
  What the public portfolio shows. Each part is null when nothing is published or there is no ready resume.
  Service key: the backend and portfolio call this. The owner key gets a 401 here.
}
