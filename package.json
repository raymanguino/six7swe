{
  "name": "root",
  "private": true,
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "engines": {
    "node": ">=26 <27"
  },
  "workspaces": [
    "backend",
    "frontend",
    "knowledge",
    "packages/*"
  ],
  "scripts": {
    "lint": "pnpm build:types && eslint . --ext .ts,.tsx",
    "lint:fix": "pnpm build:types && eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "build": "pnpm --filter @six7swe/backend build && pnpm --filter @six7swe/knowledge build && pnpm --filter @six7swe/frontend build",
    "build:types": "pnpm --filter @six7swe/knowledge-types build",
    "build:backend": "pnpm --filter @six7swe/backend build",
    "build:knowledge": "pnpm --filter @six7swe/knowledge build",
    "build:frontend": "pnpm --filter @six7swe/frontend build",
    "start": "pnpm --filter @six7swe/backend start",
    "start:frontend": "pnpm --filter @six7swe/frontend preview",
    "dev": "pnpm build:types && pnpm --filter @six7swe/backend dev",
    "dev:knowledge": "pnpm build:types && pnpm --filter @six7swe/knowledge dev",
    "dev:frontend": "pnpm --filter @six7swe/frontend dev",
    "debug": "pnpm build:types && pnpm --filter @six7swe/backend debug",
    "test": "pnpm --filter @six7swe/backend test && pnpm --filter @six7swe/knowledge test",
    "test:knowledge": "pnpm --filter @six7swe/knowledge test",
    "test:watch": "pnpm --filter @six7swe/backend test:watch",
    "test:coverage": "pnpm --filter @six7swe/backend test:coverage",
    "pr:size": "pnpm --filter @six7swe/backend pr:size"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.8.1",
    "railway": "3.17.0",
    "typescript": "^5.9.3"
  }
}
